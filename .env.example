NODE_ENV=development
PORT=3000
APP_STATUS=active
PUBLIC_ORIGIN=https://training.example.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sport_athlete
DB_USER=sport_athlete
DB_PASSWORD=change-me
DB_CONNECTION_LIMIT=5

# Production: place the app behind Authentik or an equivalent trusted auth proxy.
# Use at least 32 random characters and never commit the real value.
AUTH_MODE=proxy
AUTH_PROXY_SHARED_SECRET=replace-with-at-least-32-random-characters
AUTH_PROXY_SECRET_HEADER=x-sam-proxy-secret
AUTH_SUBJECT_HEADER=x-authentik-uid
AUTH_EMAIL_HEADER=x-authentik-email
AUTH_NAME_HEADER=x-authentik-name

# Development only. Refused automatically in NODE_ENV=production.
DEV_USER_ID=demo-athlete
DEV_USER_EMAIL=demo@example.invalid
DEV_USER_NAME=Demo Athlete

# Optional external reasoning endpoint implementing the Skillz adaptation contract.
SKILLZ_ADAPTATION_URL=
SKILLZ_ADAPTATION_TOKEN=
SKILLZ_ADAPTATION_TIMEOUT_MS=5000
