NODE_ENV=development
PORT=3000
APP_STATUS=active
PUBLIC_ORIGIN=https://training.example.com

# TRANSITIONAL provider configuration: the current Sport runtime still uses
# MariaDB 11.8 until the dedicated PostgreSQL migration is complete.
# Production MariaDB remains private; never publish port 3306 publicly and use
# SSH/private-network paths for external administration.
#
# Platform target after that migration (do not enable before the provider code
# and PostgreSQL migrations land):
# DATABASE_URL=postgresql://sport_athlete_app:<secret>@postgres:5432/sport_athlete
# DB_POOL_MAX=5
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sport_athlete
DB_USER=sport_athlete
DB_PASSWORD=change-me
DB_CONNECTION_LIMIT=5

# Production: place the app behind Authentik or an equivalent trusted auth proxy.
# Use at least 32 random characters and never commit the real value.
AUTH_MODE=proxy
AUTH_PROXY_SHARED_SECRET=replace-with-at-least-32-random-characters
AUTH_PROXY_SECRET_HEADER=x-sam-proxy-secret
AUTH_SUBJECT_HEADER=x-authentik-uid
AUTH_EMAIL_HEADER=x-authentik-email
AUTH_NAME_HEADER=x-authentik-name

# Development only. Refused automatically in NODE_ENV=production.
DEV_USER_ID=demo-athlete
DEV_USER_EMAIL=demo@example.invalid
DEV_USER_NAME=Demo Athlete

# Optional external reasoning endpoint implementing the P0 Skillz adaptation contract.
SKILLZ_ADAPTATION_URL=
SKILLZ_ADAPTATION_TOKEN=
SKILLZ_ADAPTATION_TIMEOUT_MS=5000

# External Skillz specialist runtime. The product sends one selected specialist request at a time.
# Blank URL keeps generation fail-closed: a reasoning run is recorded as failed and no artifact is invented.
SKILLZ_SPECIALIST_URL=
SKILLZ_SPECIALIST_TOKEN=
SKILLZ_SPECIALIST_TIMEOUT_MS=15000
# Pin the deployed Skillz source revision for audit provenance when the runtime does not return one.
SKILLZ_SOURCE_REVISION=

# Private service-to-service boundary for P1/P2 ingest and producer triggers.
# Use a distinct secret of at least 32 random characters; never expose it to the browser.
SPECIALIST_SERVICE_SHARED_SECRET=
SPECIALIST_SERVICE_SECRET_HEADER=x-sam-specialist-secret

# Legacy compatibility: if SPECIALIST_SERVICE_* is blank, existing P1_* values are used.
P1_INGEST_SHARED_SECRET=
P1_INGEST_SECRET_HEADER=x-sam-p1-ingest-secret
